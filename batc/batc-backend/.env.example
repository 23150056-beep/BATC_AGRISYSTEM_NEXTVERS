# Copy this file to ".env" in the same folder, then fill in the values.
#   Windows:        copy .env.example .env
#   macOS / Linux:  cp .env.example .env

# Django secret key — any long random string works for local/demo use.
SECRET_KEY=change-me-to-any-long-random-string

# Keep True for local development and demos.
DEBUG=True

# Leave empty — a key is derived from SECRET_KEY automatically.
CRYPTOGRAPHY_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
